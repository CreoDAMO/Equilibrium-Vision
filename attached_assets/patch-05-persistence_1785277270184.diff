+  // ── Persistence helpers (M4 + M5) ───────────────────────────────────────
+
+  private async persistSmtRoot(block: Block) {
+    if (!this.db) return;
+    const root = this.smt.root();
+    await this.db.query(
+      `INSERT INTO smt_roots (height, block_hash, state_root, created_at)
+       VALUES ($1, $2, $3, NOW())
+       ON CONFLICT (height) DO UPDATE SET state_root = EXCLUDED.state_root, created_at = NOW()`,
+      [block.height, block.hash, root]
+    );
+  }
+
+  private async persistPool(pool: DexPool) {
+    if (!this.db) return;
+    await this.db.query(
+      `INSERT INTO dex_pools (id, token_a, token_b, reserve_a, reserve_b, total_liquidity, created_at, updated_at)
+       VALUES ($1, $2, $3, $4, $5, $6, NOW(), NOW())
+       ON CONFLICT (id) DO UPDATE SET
+         reserve_a = EXCLUDED.reserve_a,
+         reserve_b = EXCLUDED.reserve_b,
+         total_liquidity = EXCLUDED.total_liquidity,
+         updated_at = NOW()`,
+      [pool.id, pool.tokenA, pool.tokenB, pool.reserveA, pool.reserveB, pool.totalLiquidity]
+    );
+  }
+
+  private async loadPersistedState() {
+    if (!this.db) return;
+    // Load DEX pools
+    const poolsRes = await this.db.query(`SELECT * FROM dex_pools`);
+    for (const row of poolsRes.rows) {
+      this.dexPools.set(row.id, {
+        id: row.id,
+        tokenA: row.token_a,
+        tokenB: row.token_b,
+        reserveA: Number(row.reserve_a),
+        reserveB: Number(row.reserve_b),
+        totalLiquidity: Number(row.total_liquidity),
+      });
+    }
+    // Load latest SMT root for fast-path verification
+    const smtRes = await this.db.query(`SELECT * FROM smt_roots ORDER BY height DESC LIMIT 1`);
+    if (smtRes.rows.length > 0) {
+      console.log(`[ChainState] Loaded SMT root at height ${smtRes.rows[0].height}`);
+    }
+  }
+

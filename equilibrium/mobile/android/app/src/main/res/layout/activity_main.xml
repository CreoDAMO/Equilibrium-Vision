<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── App title ──────────────────────────────────────────────────── -->

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- ── P2P mode toggle ────────────────────────────────────────────── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/p2p_mode_label"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/p2pModeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeHttp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_http" />

            <RadioButton
                android:id="@+id/modeHybrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:checked="true"
                android:text="@string/mode_hybrid" />

            <RadioButton
                android:id="@+id/modeP2p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/mode_p2p" />

        </RadioGroup>

        <!-- ── Network status ────────────────────────────────────────────── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mining_status_label"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/statusHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_height_default"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/statusPeers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/status_peers_default"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/statusTipSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/status_tip_source_default"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/statusLastGossip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/status_last_gossip_default"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ── Actions ───────────────────────────────────────────────────── -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startNodeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/start_node_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/joinNetworkBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/join_network_button" />

        <!-- Legacy single-address bootstrap (kept for CLI/power users) -->
        <EditText
            android:id="@+id/bootstrapInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/bootstrap_hint"
            android:inputType="textUri"
            android:maxLines="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectBootstrapButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/connect_bootstrap_button" />

        <!-- ── Update check ───────────────────────────────────────────────── -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkUpdatesButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/check_updates_button" />

        <ProgressBar
            android:id="@+id/updateProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>

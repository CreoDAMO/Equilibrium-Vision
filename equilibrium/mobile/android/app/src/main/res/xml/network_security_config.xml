<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network security configuration for Equilibrium Miner.

  * All traffic to public hosts requires HTTPS (no cleartext).
  * Debug builds substitute the entire file with src/debug/res/xml/
    network_security_config.xml (which adds cleartext for local dev hosts).
  * <debug-overrides> may ONLY contain <trust-anchors> per the Android
    Network Security Config schema — do NOT add <domain-config> here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow user-installed CAs in ALL builds (debug + release) for
         corporate proxies and dev mTLS certs. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for submitting solved blocks -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera for QR code scanning via ZXing IntentIntegrator -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Required to start MiningService as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- POST_NOTIFICATIONS for the persistent miner notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager constraint: only mine when charging + on unmetered network -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EquilibriumMiner"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="equilibrium" android:host="bootstrap" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="equilibrium" android:host="bootstrap" />
            </intent-filter>
        </activity>

        <!--
            BootstrapQrActivity — QR display / scan screen for peer bootstrapping.
            Not exported: only launched internally via MainActivity's "Join Network" button,
            or via the equilibrium:// deep-link intent filter below.
            android:launchMode="singleTop" ensures onNewIntent fires if the activity
            is already on top when a second equilibrium:// deep-link arrives.
        -->
        <activity
            android:name=".BootstrapQrActivity"
            android:exported="false"
            android:launchMode="singleTop">
            <!-- Accept equilibrium://bootstrap deep-links when the QR screen is
                 already open (e.g. user taps an NFC tag while viewing their own QR). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="equilibrium" android:host="bootstrap" />
            </intent-filter>
        </activity>

        <!--
            MiningService — long-running foreground service.
            type="dataSync" is the least-restrictive type allowed for CPU work;
            switch to "specialUse" + declaration if the Play Store policy changes.
        -->
        <service
            android:name=".MiningService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            MiningWorker — used by WorkManager for battery-aware scheduling.
            Constraints: setRequiresCharging(true) + setRequiredNetworkType(UNMETERED)
            are enforced at runtime in MiningWorker.kt.
        -->
        <provider
            android:name="androidx.work.impl.WorkManagerInitializer"
            android:authorities="${applicationId}.workmanager-init"
            android:exported="false"
            tools:node="remove"
            xmlns:tools="http://schemas.android.com/tools" />

    </application>

</manifest>
